{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-07-30 23:51:18.124668",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Material Request",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <style>\n        /* =========================================================\n           PAGE SETUP & GENERAL STYLES\n           ========================================================= */\n        @page {\n            size: A4 portrait;\n            margin: 10mm;\n        }\n\n        html, body {\n            width: 100%;\n            margin: 0;\n            padding: 0;\n        }\n\n        body {\n            font-family: Arial, Helvetica, sans-serif;\n            color: #000000;\n            background-color: #ffffff;\n            line-height: 1.2;\n            font-size: 10px;\n\n            -webkit-print-color-adjust: exact !important;\n            print-color-adjust: exact !important;\n        }\n\n        /* =========================================================\n           MAIN CONTAINER FRAME\n           ========================================================= */\n        .outer-frame {\n            width: 100%;\n            box-sizing: border-box;\n            border: 1.5px solid #000000;\n            padding: 8px;\n            margin: 0 auto;\n            position: relative;\n        }\n\n        /* =========================================================\n           TABLE STYLES\n           ========================================================= */\n        table {\n            width: 100%;\n            border-collapse: collapse;\n            table-layout: fixed;\n        }\n\n        .border-table, .border-table th, .border-table td {\n            border: 1px solid #000000;\n        }\n\n        .border-table th {\n            font-weight: bold;\n            text-align: center;\n            padding: 5px 2px;\n            font-size: 9.5px;\n            background-color: #ffffff;\n        }\n\n        .border-table td {\n            padding: 3px 4px;\n            font-size: 9px;\n            box-sizing: border-box;\n        }\n\n        .align-center { text-align: center; }\n        .align-right { text-align: right; }\n        .align-left { text-align: left; }\n\n        /* =========================================================\n           SPECIAL SECTIONS\n           ========================================================= */\n        .header-title {\n            text-align: center;\n            font-size: 18px;\n            font-weight: bold;\n            letter-spacing: 0.5px;\n            margin-top: 5px;\n            margin-bottom: 15px;\n        }\n\n        .appendix-text {\n            position: absolute;\n            top: 8px;\n            right: 8px;\n            font-size: 11px;\n            font-weight: bold;\n        }\n\n        .info-table td {\n            padding: 4px;\n            vertical-align: middle;\n            border: 1px solid #000000;\n        }\n\n        .checkbox-box {\n            display: inline-block;\n            width: 10px;\n            height: 10px;\n            border: 1px solid #000;\n            margin-right: 4px;\n            vertical-align: middle;\n        }\n\n        .line-field {\n            border-bottom: 1px solid #000000;\n            display: inline-block;\n            width: 75%;\n            min-height: 12px;\n            vertical-align: bottom;\n            padding-left: 5px;\n        }\n\n        /* Print Override */\n        @media print {\n            .outer-frame {\n                border: 1.5px solid #000000 !important;\n            }\n        }\n    </style>\n</head>\n<body>\n\n    <div class=\"outer-frame\">\n\n        <!-- APPENDIX REFERENCE -->\n        <div class=\"appendix-text\">\n            Annex A.5\n        </div>\n\n        <!-- DOCUMENT TITLE -->\n        <div class=\"header-title\">\n            INVENTORY TRANSFER REPORT\n        </div>\n\n        <!-- HEADER DATA SECTION -->\n        <table class=\"border-table\" style=\"margin-bottom: -1px;\">\n            <tr>\n                <td width=\"55%\" style=\"padding: 4px 6px;\">\n                    <strong>Entity Name:</strong> \n                    <span class=\"line-field\">{{ doc.company or doc.custom_client or \"\" }}</span>\n                </td>\n                <td width=\"45%\" style=\"padding: 4px 6px;\">\n                    <strong>Fund Cluster:</strong> \n                    <span class=\"line-field\">{{ doc.custom_fund_cluster or \"\" }}</span>\n                </td>\n            </tr>\n            <tr>\n                <td style=\"padding: 4px 6px;\">\n                    <strong>From:</strong> \n                    <span class=\"line-field\">{{ doc.from_warehouse or \"\" }}</span>\n                </td>\n                <td style=\"padding: 4px 6px;\">\n                    <strong>ITR No.:</strong> \n                    <span class=\"line-field\" style=\"font-weight: bold;\">{{ doc.name }}</span>\n                </td>\n            </tr>\n            <tr>\n                <td style=\"padding: 4px 6px;\">\n                    <strong>To:</strong> \n                    <span class=\"line-field\">{{ doc.to_warehouse or \"\" }}</span>\n                </td>\n                <td style=\"padding: 4px 6px;\">\n                    <strong>Date:</strong> \n                    <span class=\"line-field\">{{ doc.posting_date or doc.transaction_date or \"\" }}</span>\n                </td>\n            </tr>\n            <tr>\n                <td colspan=\"2\" style=\"padding: 6px;\">\n                    <strong>Transfer Type:</strong> (Check only one)\n                    <div style=\"margin-top: 6px; display: flex; justify-content: space-between; padding-right: 15px;\">\n                        <span><span class=\"checkbox-box\"></span> Donation</span>\n                        <span><span class=\"checkbox-box\"></span> Reassignment</span>\n                        <span><span class=\"checkbox-box\"></span> Relocate</span>\n                        <span><span class=\"checkbox-box\"></span> Others (Specify) for Turn-in <span style=\"border-bottom: 1px solid #000; width: 80px; display: inline-block;\"></span></span>\n                    </div>\n                </td>\n            </tr>\n        </table>\n\n        <!-- ITEM TABLE -->\n        <table class=\"border-table\">\n            <thead>\n                <tr>\n                    <th width=\"14%\">Date Acquired</th>\n                    <th width=\"14%\">Property No.</th>\n                    <th width=\"15%\">ICS No./Date</th>\n                    <th width=\"33%\">Description</th>\n                    <th width=\"12%\">Amount</th>\n                    <th width=\"12%\">Condition of Inventory</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% set total_amount = [] %}\n                {% for item in doc.items %}\n                    {% set item_d = frappe.db.sql(\"Select valuation_rate from `tabItem` where name =%s\", item.item_code, as_dict=1)%}\n                    {% set amount = item.amount or (item.qty * item_d[0].valuation_rate) or 0 %}\n                    {% set _ = total_amount.append(amount) %}\n                    <tr style=\"height: 18px;\">\n                        <td class=\"align-center\">{{ item.custom_date_acquired or \"\" }}</td>\n                        <td class=\"align-center\">{{ item.item_code }}</td>\n                        <td class=\"align-center\">{{ item.custom_ics_no_date or \"\" }}</td>\n                        <td>\n                            {{ item.item_name }}\n                            {% if item.description and item.description != item.item_name %}\n                                <br><small style=\"color: #444;\">{{ item.description }}</small>\n                            {% endif %}\n                        </td>\n                        <td class=\"align-right\">{{ \"{:,.2f}\".format(amount) if amount else \"\" }}</td>\n                        <td class=\"align-center\">{{ item.custom_condition or \"\" }}</td>\n                    </tr>\n                {% endfor %}\n\n                <!-- NOTHING FOLLOWS Marker -->\n                <tr>\n                    <td colspan=\"6\" class=\"align-center\" style=\"font-weight: bold; font-size: 8px; letter-spacing: 1px; padding: 2px;\">\n                        ***** NOTHING FOLLOWS *****\n                    </td>\n                </tr>\n\n                <!-- FILLER ROWS TO MATCH PAGE HEIGHT (20 total rows target) -->\n                {% set total_items = doc.items | length %}\n                {% set max_rows = 15 %}\n                {% if total_items < max_rows %}\n                    {% for i in range(total_items + 1, max_rows + 1) %}\n                    <tr style=\"height: 18px;\">\n                        <td></td><td></td><td></td><td></td><td></td><td></td>\n                    </tr>\n                    {% endfor %}\n                {% endif %}\n\n                <!-- TOTAL ROW -->\n                <tr>\n                    <td colspan=\"4\" class=\"align-right\" style=\"font-weight: bold; padding-right: 8px;\">TOTAL</td>\n                    <td class=\"align-right\" style=\"font-weight: bold;\">\n                        {{ \"{:,.2f}\".format(total_amount | sum) }}\n                    </td>\n                    <td></td>\n                </tr>\n            </tbody>\n        </table>\n\n        <!-- REASON FOR TRANSFER -->\n        <table class=\"border-table\" style=\"margin-top: -1px;\">\n            <tr>\n                <td style=\"height: 45px; vertical-align: top; padding: 5px;\">\n                    <strong>Reason/s for Transfer:</strong>\n                    <div style=\"margin-top: 4px; padding-left: 10px;\">\n                        {{ doc.reason_for_transfer or doc.remarks or \"\" }}\n                    </div>\n                </td>\n            </tr>\n        </table>\n\n        <!-- SIGNATURE BLOCK -->\n        <table class=\"border-table\" style=\"margin-top: -1px;\">\n            <thead>\n                <tr>\n                    <th width=\"33%\" class=\"align-left\">Approved by:</th>\n                    <th width=\"33%\" class=\"align-left\">Released/Issued by:</th>\n                    <th width=\"34%\" class=\"align-left\">Received by:</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <!-- APPROVED BY -->\n                    <td valign=\"top\" style=\"padding: 8px 6px;\">\n                        <div style=\"margin-bottom: 6px;\">\n                            Signature: <span class=\"line-field\"></span>\n                        </div>\n                        <div style=\"margin-bottom: 6px;\">\n                            Printed Name: <span class=\"line-field\" style=\"font-weight: bold;\">{{ doc.approved_by_name or \"\" }}</span>\n                        </div>\n                        <div style=\"margin-bottom: 6px;\">\n                            Designation: <span class=\"line-field\">{{ doc.approved_by_designation or \"\" }}</span>\n                        </div>\n                        <div>\n                            Date: <span class=\"line-field\">{{ doc.approval_date or \"\" }}</span>\n                        </div>\n                    </td>\n\n                    <!-- RELEASED / ISSUED BY -->\n                    <td valign=\"top\" style=\"padding: 8px 6px;\">\n                        <div style=\"margin-bottom: 6px;\">\n                            Signature: <span class=\"line-field\"></span>\n                        </div>\n                        <div style=\"margin-bottom: 6px;\">\n                            Printed Name: <span class=\"line-field\" style=\"font-weight: bold;\">{{ doc.issued_by_name or \"\" }}</span>\n                        </div>\n                        <div style=\"margin-bottom: 6px;\">\n                            Designation: <span class=\"line-field\">{{ doc.issued_by_designation or \"\" }}</span>\n                        </div>\n                        <div>\n                            Date: <span class=\"line-field\">{{ doc.issue_date or \"\" }}</span>\n                        </div>\n                    </td>\n\n                    <!-- RECEIVED BY -->\n                    <td valign=\"top\" style=\"padding: 8px 6px;\">\n                        <div style=\"margin-bottom: 6px;\">\n                            Signature: <span class=\"line-field\"></span>\n                        </div>\n                        <div style=\"margin-bottom: 6px;\">\n                            Printed Name: <span class=\"line-field\" style=\"font-weight: bold;\">{{ doc.received_by_name or doc.custom_client or \"\" }}</span>\n                        </div>\n                        <div style=\"margin-bottom: 6px;\">\n                            Designation: <span class=\"line-field\">{{ doc.received_by_designation or \"\" }}</span>\n                        </div>\n                        <div>\n                            Date: <span class=\"line-field\">{{ doc.receipt_date or \"\" }}</span>\n                        </div>\n                    </td>\n                </tr>\n            </tbody>\n        </table>\n\n    </div>\n\n</body>\n</html>",
