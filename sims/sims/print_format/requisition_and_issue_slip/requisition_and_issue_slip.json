 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <style>\n        /* =========================================================\n           PAGE SETUP\n           ========================================================= */\n        @page {\n            size: A4 portrait;\n            margin: 10mm;\n        }\n\n        html, body {\n            width: 100%;\n            margin: 0;\n            padding: 0;\n        }\n\n        body {\n            font-family: Arial, Helvetica, sans-serif;\n            color: #072b61;\n            background-color: #ffffff;\n            line-height: 1.3;\n\n            -webkit-print-color-adjust: exact !important;\n            print-color-adjust: exact !important;\n        }\n\n        /* =========================================================\n           MAIN OUTER FRAME\n           ========================================================= */\n        .outer-frame {\n            width: 100%;\n            box-sizing: border-box;\n            border: 2px solid #072b61 !important;\n            padding: 10px;\n            margin: 0 auto;\n            position: relative;\n        }\n\n        /* =========================================================\n           GENERAL & LAYOUT TABLES\n           ========================================================= */\n        table.layout {\n            border-spacing: 0;\n            border-collapse: collapse;\n            width: 100%;\n            margin-bottom: 8px;\n        }\n\n        .data-table tr {\n            page-break-inside: avoid;\n            break-inside: avoid;\n        }\n\n        /* =========================================================\n           SECTION HEADERS & BLUE BLOCKS\n           ========================================================= */\n        .blue-section-head {\n            background-color: #072b61 !important;\n            color: #ffffff !important;\n            font-size: 11px;\n            font-weight: bold;\n            padding: 5px 10px;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n            -webkit-print-color-adjust: exact !important;\n            print-color-adjust: exact !important;\n        }\n\n        /* =========================================================\n           DATA TABLE & HEADER FIXES\n           ========================================================= */\n        .data-table {\n            width: 100%;\n            border-collapse: collapse;\n            margin-bottom: 5px;\n            table-layout: fixed;\n        }\n\n        .data-table th, \n        .data-table td {\n            border: 1px solid #a3b8cc !important;\n            padding: 4px;\n            font-size: 9px;\n            box-sizing: border-box;\n        }\n\n        .data-table th, \n        .data-table td.align-center {\n            text-align: center;\n        }\n        .data-table td.align-right {\n            text-align: right;\n        }\n\n        /* Dark Blue Title Row (Level 1) */\n        .data-table thead tr.main-title-row th {\n            background-color: #072b61 !important;\n            color: #ffffff !important;\n            font-size: 10px;\n            font-weight: bold;\n            text-transform: uppercase;\n            padding: 4px;\n            border: 1px solid #072b61 !important;\n            letter-spacing: 1px;\n            -webkit-print-color-adjust: exact !important;\n            print-color-adjust: exact !important;\n        }\n\n        /* Light Sub-Header Row (Level 2: REQUISITION | STOCK AVAIL | ISSUE) */\n        .data-table thead tr.group-header-row th {\n            background-color: #f4f7fa !important;\n            color: #072b61 !important;\n            font-size: 9px;\n            font-weight: bold;\n            text-transform: uppercase;\n            padding: 3px;\n            border: 1px solid #a3b8cc !important;\n            -webkit-print-color-adjust: exact !important;\n            print-color-adjust: exact !important;\n        }\n\n        /* Column Titles (Level 3: Stock No., Unit, Description, etc.) */\n        .data-table thead tr.col-title-row th {\n            color: #072b61;\n            font-weight: bold;\n            background-color: #ffffff !important;\n            vertical-align: middle;\n            font-size: 8.5px;\n        }\n\n        /* =========================================================\n           SIGNATURE TABLE SPECIFIC STYLES\n           ========================================================= */\n        .signature-table {\n            width: 100%;\n            border-collapse: collapse;\n            margin-top: 10px;\n            table-layout: fixed;\n        }\n\n        .signature-table th {\n            background-color: #072b61 !important;\n            color: #ffffff !important;\n            font-size: 10px;\n            font-weight: bold;\n            text-align: center;\n            padding: 4px;\n            border: 1px solid #072b61 !important;\n            -webkit-print-color-adjust: exact !important;\n            print-color-adjust: exact !important;\n        }\n\n        .signature-table td {\n            border: 1px solid #a3b8cc !important;\n            padding: 6px;\n            font-size: 9px;\n            box-sizing: border-box;\n            background-color: #ffffff;\n        }\n\n        /* =========================================================\n           PRINT SETTINGS\n           ========================================================= */\n        @media print {\n            .outer-frame {\n                border: 2px solid #072b61 !important;\n            }\n            .blue-section-head,\n            .data-table thead tr.main-title-row th,\n            .signature-table th {\n                background-color: #072b61 !important;\n                color: #ffffff !important;\n            }\n            .data-table thead tr.group-header-row th {\n                background-color: #f4f7fa !important;\n                color: #072b61 !important;\n            }\n            .data-table th, \n            .data-table td,\n            .signature-table td {\n                border: 1px solid #a3b8cc !important;\n            }\n        }\n    </style>\n</head>\n<body>\n\n    <div class=\"outer-frame\">\n\n        <!-- APPENDIX -->\n        <div style=\"position: absolute; top: 10px; right: 10px; font-size: 10px; color: #072b61; font-weight: bold;\">\n            Appendix 63\n        </div>\n\n        <!-- 1. HEADER -->\n        <div style=\"text-align: center; margin-bottom: 20px; margin-top: 5px;\">\n            <div style=\"font-size: 24px; font-weight: 900; color: #072b61; text-transform: uppercase; letter-spacing: 1px;\">\n                REQUISITION AND ISSUE SLIP\n            </div>\n            <div style=\"font-size: 10px; font-weight: bold; color: #072b61; margin-top: 3px; letter-spacing: 0.5px;\">\n                SIMS-GENERATED RIS / OFFICIAL ISSUANCE DOCUMENT\n            </div>\n        </div>\n\n        <!-- 2. TOP PANELS -->\n        <table class=\"layout\" style=\"table-layout: fixed; margin-bottom: 12px;\">\n            <tr>\n                <!-- LEFT PANEL: ENTITY INFO -->\n                <td width=\"65%\" valign=\"top\" style=\"padding-right: 15px;\">\n                    <table class=\"data-table\" style=\"margin-bottom: 0; width: 100%;\">\n                        <tr>\n                            <td width=\"35%\" style=\"font-weight: bold; color: #072b61;\">Entity Name:</td>\n                            <td width=\"65%\">{{ doc.custom_client or \"\" }}</td>\n                        </tr>\n                        <tr>\n                            <td style=\"font-weight: bold; color: #072b61;\">Division:</td>\n                            <td>{{ doc.custom_department or \"\" }}</td>\n                        </tr>\n                        <tr>\n                            <td style=\"font-weight: bold; color: #072b61;\">Office:</td>\n                            <td></td>\n                        </tr>\n                        <tr>\n                            <td style=\"font-weight: bold; color: #072b61;\">Responsibility Center Code:</td>\n                            <td></td>\n                        </tr>\n                        <tr>\n                            <td style=\"font-weight: bold; color: #072b61;\">Fund Cluster:</td>\n                            <td></td>\n                        </tr>\n                        <tr>\n                            <td style=\"font-weight: bold; color: #072b61; border-top: 2px solid #072b61 !important; border-bottom: 2px solid #072b61 !important;\">RIS No.:</td>\n                            <td style=\"font-weight: bold; font-size: 14px; border-top: 2px solid #072b61 !important; border-bottom: 2px solid #072b61 !important;\">\n                                {{ doc.name }}\n                            </td>\n                        </tr>\n                    </table>\n                </td>\n\n                <!-- RIGHT PANEL: QR / BARCODE REFERENCE -->\n                <td width=\"35%\" valign=\"top\">\n                    {% set tracking_url = doc.name %}\n                    {% set qr_api_url = \"https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=\" ~ tracking_url | urlencode %}\n                    {% set barcode_api_url = \"https://bwipjs-api.metafloor.com/bwipjs?bcid=code128&text=\" ~ tracking_url | urlencode ~ \"&scale=3&height=15&includetext=false\" %}\n\n                    <div class=\"blue-section-head\" style=\"text-align: center; font-size: 10px; padding: 4px;\">\n                        QR / BARCODE REFERENCE\n                    </div>\n                    <div style=\"border: 1px solid #072b61; border-top: none; padding: 8px; text-align: center;\">\n                        <div style=\"font-size: 9px; font-weight: bold; color: #072b61; margin-bottom: 6px; text-align: left;\">\n                            SIMS Requisition No.: <span style=\"font-weight: normal; text-decoration: underline;\">{{ doc.name }}</span>\n                        </div>\n\n                        <table style=\"width: 100%; border-spacing: 0;\">\n                            <tr>\n                                <!-- QR CODE -->\n                                <td width=\"40%\" align=\"center\" style=\"border: 1px solid #a3b8cc; padding: 2px;\">\n                                    <img src=\"{{ qr_api_url }}\" width=\"45\" height=\"45\" style=\"display: block; margin: 0 auto;\" alt=\"QR\">\n                                </td>\n                                <td width=\"10%\"></td>\n                                <!-- BARCODE -->\n                                <td width=\"50%\" align=\"center\" style=\"border: 1px solid #a3b8cc; padding: 2px; vertical-align: middle;\">\n                                    <img src=\"{{ barcode_api_url }}\" width=\"100%\" height=\"35\" style=\"display: block; border: 0;\" alt=\"Barcode\">\n                                </td>\n                            </tr>\n                        </table>\n                    </div>\n                </td>\n            </tr>\n        </table>\n\n        <!-- 3. DATA TABLE WITH MULTI-LEVEL HEADERS -->\n        <table class=\"data-table\">\n            <thead>\n                <!-- Title Bar -->\n                <tr class=\"main-title-row\">\n                    <th colspan=\"10\" align=\"center\">REQUISITION / ISSUE DETAILS</th>\n                </tr>\n\n                <!-- Group Header Row (REQUISITION | STOCK AVAIL | ISSUE) -->\n                <tr class=\"group-header-row\">\n                    <th colspan=\"6\" align=\"center\">REQUISITION</th>\n                    <th colspan=\"2\" align=\"center\">STOCK AVAIL</th>\n                    <th colspan=\"2\" align=\"center\">ISSUE</th>\n                </tr>\n\n                <!-- Individual Column Titles Row -->\n                <tr class=\"col-title-row\">\n                    <th width=\"10%\" class=\"align-center\">Stock No. / SKU</th>\n                    <th width=\"6%\" class=\"align-center\">Unit</th>\n                    <th width=\"28%\" class=\"align-center\">Description</th>\n                    <th width=\"7%\" class=\"align-center\">Quantity</th>\n                    <th width=\"10%\" class=\"align-center\">Unit Value</th>\n                    <th width=\"10%\" class=\"align-center\">Total Value</th>\n                    <th width=\"4%\" class=\"align-center\">Yes</th>\n                    <th width=\"4%\" class=\"align-center\">No</th>\n                    <th width=\"7%\" class=\"align-center\">Quantity</th>\n                    <th width=\"14%\" class=\"align-center\">Remarks</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% set total = []%}\n                {% for item in doc.items %}\n                {% set item_d = frappe.db.sql(\"Select valuation_rate from `tabItem` where name =%s\", item.item_code, as_dict=1)%}\n                {% set rowtotal = item.qty * item_d[0].valuation_rate%}\n                {% set _=total.append(rowtotal)%}\n                <tr>\n                    <td class=\"align-center\">{{ item.item_code }}</td>\n                    <td class=\"align-center\">{{ item.uom }}</td>\n                    <td>\n                        {{ item.item_name }}\n                        {% if item.description and item.description != item.item_name %}\n                            <br><small style=\"color: #555;\">{{ item.description }}</small>\n                        {% endif %}\n                    </td>\n                    <td class=\"align-center\">{{ item.qty }}</td>\n                    <td class=\"align-right\">\n                        {{ \"{:,.2f}\".format(item_d[0].valuation_rate) if item_d and item_d[0].valuation_rate else \"\" }}\n                    </td>\n                    \n                    <td class=\"align-right\">\n                        {{ \"{:,.2f}\".format(rowtotal) if item_d and item_d[0].valuation_rate else \"\" }}\n                    </td>\n                    <td></td>\n                    <td></td>\n                    <td></td>\n                    <td></td>\n                </tr>\n                {% endfor %}\n\n                <!-- Padding Rows -->\n                {% set total_items = doc.items | length %}\n                {% set max_rows = 20 %}\n                {% if total_items < max_rows %}\n                  {% for i in range(total_items + 1, max_rows + 1) %}\n                  <tr style=\"height: 18px;\">\n                    <td></td><td></td><td></td><td></td><td></td>\n                    <td></td><td></td><td></td><td></td><td></td>\n                  </tr>\n                  {% endfor %}\n                {% endif %}\n\n                <!-- TOTAL ROW -->\n                <tr>\n                    <td colspan=\"5\" class=\"align-right\" style=\"font-weight: bold;\">TOTAL:</td>\n                    <td>{{\"{:,.2f}\".format(total|sum)}}</td>\n                    <td colspan=\"4\" style=\"background-color: #f2f2f2;\"></td>\n                </tr>\n            </tbody>\n        </table>\n\n        <!-- 4. AUTHORITY & PURPOSE -->\n        <table class=\"layout\" style=\"table-layout: fixed; border: 1px solid #a3b8cc; margin-top: 10px;\">\n            <tr>\n                <td width=\"15%\" style=\"color: #072b61; font-weight: bold; border-right: 1px solid #a3b8cc; padding: 6px;\">Authority:</td>\n                <td width=\"85%\" style=\"padding: 6px;\"></td>\n            </tr>\n            <tr>\n                <td style=\"color: #072b61; font-weight: bold; border-right: 1px solid #a3b8cc; padding: 6px;\">Purpose:</td>\n                <td style=\"padding: 6px;\"></td>\n            </tr>\n        </table>\n\n        <!-- 5. SIGNATURE BLOCK -->\n        <table class=\"signature-table\">\n            <thead>\n                <tr>\n                    <th width=\"25%\">Requested by:</th>\n                    <th width=\"25%\">Approved by:</th>\n                    <th width=\"25%\">Issued by:</th>\n                    <th width=\"25%\">Received by:</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <!-- Requested By -->\n                    <td valign=\"top\">\n                        <div style=\"margin-bottom: 6px;\">\n                            Printed Name: <span style=\"font-weight: bold;\">{{ doc.custom_client or \"\" }}</span>\n                        </div>\n                        <div style=\"margin-bottom: 6px;\">Rank: ________________</div>\n                        <div style=\"margin-bottom: 6px;\">Designation: __________</div>\n                        <div style=\"margin-bottom: 6px;\">\n                            Date: <span style=\"font-weight: bold;\">{{ doc.transaction_date or \"\" }}</span>\n                        </div>\n                        <div style=\"margin-bottom: 2px;\">Signature: ____________</div>\n                    </td>\n\n                    <!-- Approved By -->\n                    <td valign=\"top\">\n                        <div style=\"margin-bottom: 6px;\">Printed Name: ____________</div>\n                        <div style=\"margin-bottom: 6px;\">Rank: ________________</div>\n                        <div style=\"margin-bottom: 6px;\">Designation: __________</div>\n                        <div style=\"margin-bottom: 6px;\">Date: ________________</div>\n                        <div style=\"margin-bottom: 2px;\">Signature: ____________</div>\n                    </td>\n\n                    <!-- Issued By -->\n                    <td valign=\"top\">\n                        <div style=\"margin-bottom: 6px;\">Printed Name: ____________</div>\n                        <div style=\"margin-bottom: 6px;\">Rank: ________________</div>\n                        <div style=\"margin-bottom: 6px;\">Designation: __________</div>\n                        <div style=\"margin-bottom: 6px;\">Date: ________________</div>\n                        <div style=\"margin-bottom: 2px;\">Signature: ____________</div>\n                    </td>\n\n                    <!-- Received By -->\n                    <td valign=\"top\">\n                        <div style=\"margin-bottom: 6px;\">Printed Name: ____________</div>\n                        <div style=\"margin-bottom: 6px;\">Rank: ________________</div>\n                        <div style=\"margin-bottom: 6px;\">Designation: __________</div>\n                        <div style=\"margin-bottom: 6px;\">Date: ________________</div>\n                        <div style=\"margin-bottom: 2px;\">Signature: ____________</div>\n                    </td>\n                </tr>\n            </tbody>\n        </table>\n\n        <!-- 6. FOOTER NOTE -->\n        <div style=\"font-size: 8px; font-weight: bold; color: #072b61; text-align: center; margin-top: 10px; border-top: 1px solid #a3b8cc; padding-top: 4px;\">\n             This is a system-generated attachment form. Use the QR code or barcode to verify the requisition record in SIMS.\n        </div>\n\n    </div>\n\n</body>\n</html>",
