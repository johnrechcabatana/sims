 "doc_type": "Material Request",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n\n  <style>\n    /* =========================================================\n       PAGE SETUP\n       ========================================================= */\n    @page {\n      size: A4 portrait;\n      margin: 7mm;\n    }\n\n    html,\n    body {\n      width: 100%;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      font-family: Arial, Helvetica, sans-serif;\n      color: #072b61;\n      background-color: #ffffff;\n\n      -webkit-print-color-adjust: exact !important;\n      print-color-adjust: exact !important;\n    }\n\n    /* =========================================================\n       MAIN OUTER FRAME\n       Using DIV instead of TABLE for reliable PDF border\n       ========================================================= */\n    .outer-frame {\n      width: 100%;\n      box-sizing: border-box;\n\n      border: 2px solid #072b61 !important;\n\n      padding: 8px;\n      margin: 0;\n\n      page-break-inside: avoid;\n      break-inside: avoid;\n    }\n\n    .outer-content {\n      width: 100%;\n      box-sizing: border-box;\n    }\n\n    /* =========================================================\n       GENERAL TABLE SETTINGS\n       ========================================================= */\n    table {\n      border-spacing: 0;\n    }\n\n    .print-format td,\n    .print-format th {\n      padding: 3px !important;\n    }\n\n    /* =========================================================\n       SECTION HEADER\n       ========================================================= */\n    .section-head {\n      background-color: #072b61 !important;\n      color: #ffffff !important;\n\n      font-size: 10px;\n      font-weight: bold;\n\n      padding: 3px 6px;\n\n      text-transform: uppercase;\n\n      -webkit-print-color-adjust: exact !important;\n      print-color-adjust: exact !important;\n    }\n\n    /* =========================================================\n       DATA TABLE\n       ========================================================= */\n    .data-table {\n      width: 100%;\n\n      border-collapse: collapse;\n      border-spacing: 0;\n\n      margin-bottom: 8px;\n\n      table-layout: fixed;\n    }\n\n    .data-table th,\n    .data-table td {\n      border: 1px solid #a3b8cc !important;\n\n      padding: 3px;\n\n      font-size: 9px;\n\n      box-sizing: border-box;\n    }\n\n    .data-table th {\n      color: #072b61;\n\n      font-weight: bold;\n\n      background-color: #ffffff !important;\n    }\n\n    .data-table tr {\n      page-break-inside: avoid;\n      break-inside: avoid;\n    }\n\n    /* =========================================================\n       PRINT SETTINGS\n       ========================================================= */\n    @media print {\n\n      html,\n      body {\n        width: 100%;\n        margin: 0;\n        padding: 0;\n      }\n\n      body {\n        -webkit-print-color-adjust: exact !important;\n        print-color-adjust: exact !important;\n      }\n\n      .outer-frame {\n        width: 100%;\n\n        border: 2px solid #072b61 !important;\n\n        box-sizing: border-box;\n\n        padding: 8px;\n\n        page-break-inside: avoid;\n        break-inside: avoid;\n      }\n\n      .outer-content {\n        width: 100%;\n        box-sizing: border-box;\n      }\n\n      table {\n        max-width: 100%;\n      }\n\n      img {\n        -webkit-print-color-adjust: exact !important;\n        print-color-adjust: exact !important;\n      }\n\n      .section-head {\n        background-color: #072b61 !important;\n        color: #ffffff !important;\n\n        -webkit-print-color-adjust: exact !important;\n        print-color-adjust: exact !important;\n      }\n\n      .data-table th,\n      .data-table td {\n        border: 1px solid #a3b8cc !important;\n      }\n    }\n  </style>\n</head>\n\n<body>\n\n  <!-- =========================================================\n       MAIN OUTER FRAME\n       ========================================================= -->\n\n  <div class=\"outer-frame\">\n\n    <div class=\"outer-content\">\n\n\n      <!-- =====================================================\n           1. HEADER\n           ===================================================== -->\n\n      <table\n        width=\"100%\"\n        border=\"0\"\n        cellspacing=\"0\"\n        cellpadding=\"0\"\n        style=\"margin-bottom: 8px;\"\n      >\n\n        <tr>\n\n          <!-- LEFT LOGO -->\n          <td\n            width=\"15%\"\n            align=\"left\"\n            valign=\"middle\"\n          >\n\n            <table\n              border=\"0\"\n              cellspacing=\"0\"\n              cellpadding=\"2\"\n              style=\"\n                border: 1.5px dashed #072b61;\n                border-radius: 50%;\n                width: 68px;\n                height: 68px;\n              \"\n            >\n\n              <tr>\n\n                <td\n                  align=\"center\"\n                  valign=\"middle\"\n                  style=\"\n                    font-size: 7.5px;\n                    font-weight: bold;\n                    color: #072b61;\n                  \"\n                >\n                    <img src=\"/assets/sims/img/logistic-commander.jpg\">\n                </td>\n\n              </tr>\n\n            </table>\n\n          </td>\n\n\n          <!-- TITLE -->\n          <td\n            width=\"70%\"\n            align=\"center\"\n            valign=\"middle\"\n          >\n\n            <div\n              style=\"\n                font-size: 22px;\n                font-weight: 900;\n                line-height: 1.1;\n                color: #072b61;\n                text-transform: uppercase;\n              \"\n            >\n              SIMS REQUISITION<br>\n              ATTACHMENT FORM\n            </div>\n\n            <div\n              style=\"\n                font-size: 9.5px;\n                font-weight: bold;\n                color: #072b61;\n                margin-top: 3px;\n                letter-spacing: 0.5px;\n              \"\n            >\n              SYSTEM-GENERATED REQUEST ATTACHMENT\n            </div>\n\n          </td>\n\n\n          <!-- RIGHT LOGO -->\n          <td\n            width=\"15%\"\n            align=\"right\"\n            valign=\"middle\"\n          >\n\n            <table\n              border=\"0\"\n              cellspacing=\"0\"\n              cellpadding=\"2\"\n              style=\"\n                border: 1.5px dashed #072b61;\n                border-radius: 50%;\n                width: 68px;\n                height: 68px;\n              \"\n            >\n\n              <tr>\n\n                <td\n                  align=\"center\"\n                  valign=\"middle\"\n                  style=\"\n                    font-size: 7.5px;\n                    font-weight: bold;\n                    color: #072b61;\n                  \"\n                >\n                  <img src=\"/assets/sims/img/supplyg.jpg\">\n                </td>\n\n              </tr>\n\n            </table>\n\n          </td>\n\n        </tr>\n\n      </table>\n\n\n      <!-- =====================================================\n           2. QR / BARCODE / REQUISITION NUMBER\n           ===================================================== -->\n\n      {% set tracking_url = doc.name %}\n\n      {% set qr_api_url =\n        \"https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=\"\n        ~ tracking_url | urlencode\n      %}\n\n     {% set barcode_api_url =\n  \"https://bwipjs-api.metafloor.com/bwipjs\"\n  ~ \"?bcid=code128\"\n  ~ \"&text=\" ~ tracking_url | urlencode\n  ~ \"&scale=3\"\n  ~ \"&height=15\"\n  ~ \"&includetext=false\"\n%}\n\n      <table\n        width=\"100%\"\n        border=\"0\"\n        cellspacing=\"4\"\n        cellpadding=\"0\"\n        style=\"margin-bottom: 8px;\"\n      >\n\n        <tr>\n\n\n          <!-- REQUISITION NUMBER -->\n          <td\n            width=\"40%\"\n            valign=\"top\"\n            style=\"\n              border: 1px solid #072b61 !important;\n            \"\n          >\n\n            <div\n              class=\"section-head\"\n              style=\"\n                text-align: center;\n                font-size: 8.5px;\n              \"\n            >\n              REQUISITION NUMBER\n            </div>\n\n            <div\n              style=\"\n                text-align: center;\n                padding: 18px 4px 0 4px;\n                font-size: 16px;\n                font-weight: bold;\n                color: #072b61;\n              \"\n            >\n              {{ doc.name }}\n            </div>\n\n          </td>\n\n\n          <!-- QR CODE -->\n          <td\n            width=\"20%\"\n            valign=\"top\"\n            align=\"center\"\n            style=\"\n              border: 1px solid #072b61 !important;\n            \"\n          >\n\n            <div\n              class=\"section-head\"\n              style=\"\n                text-align: center;\n                font-size: 8.5px;\n              \"\n            >\n              QR CODE\n            </div>\n\n            <div style=\"padding: 4px;\">\n\n              <img\n                src=\"{{ qr_api_url }}\"\n                width=\"56\"\n                height=\"56\"\n                style=\"\n                  display: block;\n                  margin: 0 auto;\n                \"\n                alt=\"QR Code\"\n              >\n\n              <div\n                style=\"\n                  font-size: 7px;\n                  font-weight: bold;\n                  color: #072b61;\n                  margin-top: 2px;\n                \"\n              >\n                SCAN TO VERIFY IN SIMS\n              </div>\n\n            </div>\n\n          </td>\n\n            <!-- BARCODE -->\n<td\n  width=\"40%\"\n  valign=\"top\"\n  align=\"center\"\n  style=\"\n    border: 1px solid #072b61 !important;\n    height: 85px;\n    padding: 0 !important;\n  \"\n>\n\n  <div\n    class=\"section-head\"\n    style=\"\n      text-align: center;\n      font-size: 8.5px;\n      padding: 3px 6px;\n    \"\n  >\n    BARCODE\n  </div>\n\n  <div\n    style=\"\n      width: 100%;\n      height: 60px;\n      box-sizing: border-box;\n      text-align: center;\n      padding: 4px 2px 0 2px;\n      overflow: hidden;\n    \"\n  >\n\n    <img\n      src=\"{{ barcode_api_url }}\"\n      width=\"260\"\n      height=\"42\"\n      style=\"\n        width: 260px;\n        height: 42px;\n        display: block;\n        margin: 0 auto;\n        border: 0;\n      \"\n      alt=\"Barcode\"\n    >\n\n    <div\n      style=\"\n        font-size: 8px;\n        line-height: 10px;\n        font-weight: bold;\n        color: #072b61;\n        margin-top: 1px;\n        white-space: nowrap;\n      \"\n    >\n      {{ doc.name }}\n    </div>\n\n  </div>\n\n</td>\n\n        </tr>\n\n      </table>\n\n\n      <!-- =====================================================\n           3. CONTROL / REQUEST INFORMATION\n           ===================================================== -->\n\n      <div\n        class=\"section-head\"\n        style=\"margin-bottom: 2px;\"\n      >\n        CONTROL / REQUEST INFORMATION\n      </div>\n\n\n      <table class=\"data-table\">\n\n        <tr>\n\n          <td\n            width=\"25%\"\n            style=\"color: #072b61;\"\n          >\n            Requisition Number\n          </td>\n\n          <td\n            width=\"75%\"\n            style=\"color: #000000;\"\n          >\n            <strong>{{ doc.name }}</strong>\n          </td>\n\n        </tr>\n\n\n        <tr>\n\n          <td style=\"color: #072b61;\">\n            Date Generated\n          </td>\n\n          <td style=\"color: #000000;\">\n            {{ doc.transaction_date }}\n          </td>\n\n        </tr>\n\n\n        <tr>\n\n          <td style=\"color: #072b61;\">\n            Generated By\n          </td>\n\n          <td style=\"color: #000000;\">\n            {{ doc.custom_client }}\n          </td>\n\n        </tr>\n\n\n        <tr>\n\n          <td style=\"color: #072b61;\">\n            Client Unit\n          </td>\n\n          <td style=\"color: #000000;\">\n            {{ doc.custom_department or \"N/A\" }}\n          </td>\n\n        </tr>\n\n\n        <tr>\n\n          <td style=\"color: #072b61;\">\n            Total Items\n          </td>\n\n          <td style=\"color: #000000;\">\n            {{ doc.items | length }}\n          </td>\n\n        </tr>\n\n      </table>\n\n\n      <!-- =====================================================\n           4. REQUESTED ITEMS\n           ===================================================== -->\n\n      <div\n        class=\"section-head\"\n        style=\"margin-bottom: 2px;\"\n      >\n        REQUESTED ITEMS\n      </div>\n\n\n      <table class=\"data-table\">\n\n        <thead>\n\n          <tr>\n\n            <th\n              width=\"4%\"\n              align=\"center\"\n            >\n              No.\n            </th>\n\n            <th\n              width=\"14%\"\n              align=\"center\"\n            >\n              SKU<br>\n              Number\n            </th>\n\n            <th\n              width=\"32%\"\n              align=\"center\"\n            >\n              Nomenclature / Description /<br>\n              Part Name\n            </th>\n\n            <th\n              width=\"20%\"\n              align=\"center\"\n            >\n              FSN / NSN / Code or<br>\n              Assigned Part Number\n            </th>\n\n            <th\n              width=\"12%\"\n              align=\"center\"\n            >\n              Unit Price<br>\n              (Estimated Value)\n            </th>\n\n            <th\n              width=\"9%\"\n              align=\"center\"\n            >\n              Shelf Life /<br>\n              Condition\n            </th>\n\n            <th\n              width=\"9%\"\n              align=\"center\"\n            >\n              Quantity<br>\n              Requested\n            </th>\n\n          </tr>\n\n        </thead>\n\n\n        <tbody>\n\n          {% for item in doc.items %}\n          {% set item_d = frappe.db.sql(\"Select custom_part_number, custom_condition, valuation_rate from `tabItem` where name =%s\", item.item_code,as_dict=1)%}\n\n          <tr>\n\n            <!-- ITEM NUMBER -->\n            <td\n              align=\"center\"\n              style=\"color: #000000;\"\n            >\n              {{ item.idx }}\n            </td>\n\n\n            <!-- SKU -->\n            <td\n              align=\"center\"\n              style=\"color: #000000;\"\n            >\n              {{ item.item_code }}\n            </td>\n\n\n            <!-- DESCRIPTION -->\n            <td\n              align=\"left\"\n              style=\"color: #000000;\"\n            >\n\n              {{ item.item_name }}\n\n              {% if item.description\n                    and item.description != item.item_name %}\n\n                <br>\n\n                <small style=\"color: #555;\">\n                  {{ item.description }}\n                </small>\n\n              {% endif %}\n\n            </td>\n\n\n            <!-- FSN / NSN / CODE -->\n            <td\n              align=\"center\"\n              style=\"color: #000000;\"\n            >\n              {{ item_d[0].custom_part_number or \"N/A\" }}\n            </td>\n\n\n            <!-- UNIT PRICE -->\n            <td\n              align=\"right\"\n              style=\"color: #000000;\"\n            >\n\n              {{ item_d[0].valuation_rate\n                 if item_d[0].valuation_rate else \"\" }}\n\n            </td>\n\n\n            <!-- CONDITION -->\n            <td\n              align=\"center\"\n              style=\"color: #000000;\"\n            >\n              {{ item_d[0].custom_condition or \"\" }}\n            </td>\n\n\n            <!-- QUANTITY -->\n            <td\n              align=\"center\"\n              style=\"color: #000000;\"\n            >\n              {{ item.qty }} {{ item.uom }}\n            </td>\n\n          </tr>\n\n          {% endfor %}\n\n\n          <!-- =================================================\n               PADDING ROWS\n               Keep table height consistent\n               ================================================= -->\n          \n          {% set total_items = doc.items | length %}\n            {% set max_rows = 25 %}\n            \n            {% if total_items < max_rows %}\n              {% for i in range(total_items + 1, max_rows + 1) %}\n            \n              <tr style=\"height: 18px;\">\n            \n                <td align=\"center\" style=\"color: #000000;\">\n                  {{ i }}\n                </td>\n            \n                <td></td>\n                <td></td>\n                <td></td>\n                <td></td>\n                <td></td>\n                <td></td>\n            \n              </tr>\n            \n              {% endfor %}\n            {% endif %}\n\n        </tbody>\n\n      </table>\n\n\n      <!-- =====================================================\n           5. FOOTER NOTE\n           ===================================================== -->\n\n      <table\n        width=\"100%\"\n        border=\"0\"\n        cellspacing=\"0\"\n        cellpadding=\"4\"\n        style=\"\n          border: 1px solid #a3b8cc !important;\n          border-collapse: collapse;\n          margin-top: 2px;\n        \"\n      >\n\n        <tr>\n\n          <td\n            width=\"26\"\n            align=\"center\"\n            valign=\"middle\"\n          >\n\n            <div\n              style=\"\n                background-color: #072b61;\n                color: #ffffff;\n                width: 20px;\n                height: 20px;\n                line-height: 20px;\n                text-align: center;\n                border-radius: 3px;\n                font-size: 11px;\n                font-weight: bold;\n\n                -webkit-print-color-adjust: exact;\n                print-color-adjust: exact;\n              \"\n            >\n              &#10003;\n            </div>\n\n          </td>\n\n\n          <td\n            valign=\"middle\"\n            style=\"\n              font-size: 8px;\n              font-weight: bold;\n              color: #072b61;\n              line-height: 1.3;\n            \"\n          >\n\n            This is a system-generated attachment form.<br>\n\n            Use the QR code or barcode to verify the requisition record in SIMS.\n\n          </td>\n\n        </tr>\n\n      </table>\n\n\n    </div>\n\n  </div>\n\n</body>\n</html>",
