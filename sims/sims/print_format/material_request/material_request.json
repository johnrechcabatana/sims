 "font_size": 14,
 "html": "<style>\n    @media screen {\n  .print-format {\n    padding: 0.01in !important;\n  }\n}\n</style>\n<div class=\"print-format-wrapper\" style=\"font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1e293b; padding: 20px; font-size: 13px; line-height: 1.5;\">\n    \n    <!-- 1. Header & Requisition Info -->\n    <div style=\"display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #0056b3; padding-bottom: 15px; margin-bottom: 25px;\">\n        <div>\n            <h2 style=\"color: #0056b3; margin: 0 0 5px 0; font-size: 24px; font-weight: bold; letter-spacing: -0.5px;\">MATERIAL REQUISITION FORM</h2>\n            <div style=\"color: #64748b; font-size: 12px;\">Generated via SIMS Dashboard</div>\n        </div>\n        <div style=\"text-align: right;\">\n            <div style=\"font-size: 12px; color: #64748b; text-transform: uppercase; font-weight: bold; margin-bottom: 2px;\">Requisition Number</div>\n            <div style=\"font-size: 18px; font-weight: bold; color: #0056b3;\">{{ doc.name }}</div>\n        </div>\n    </div>\n\n    <!-- 2. Metadata Context -->\n    <div style=\"display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; background: #f8fafc; border: 1px solid #e2e8f0; padding: 15px; border-radius: 6px; margin-bottom: 25px;\">\n        <div>\n            <table style=\"width: 100%; border-collapse: collapse;\">\n                <tr>\n                    <td style=\"color: #64748b; padding: 4px 0; width: 40%;\"><strong>Requestor:</strong></td>\n                    <td style=\"color: #0f172a; padding: 4px 0;\">{{ doc.custom_client or doc.owner }}</td>\n                </tr>\n                <tr>\n                    <td style=\"color: #64748b; padding: 4px 0;\"><strong>Date Requested:</strong></td>\n                    <td style=\"color: #0f172a; padding: 4px 0;\">{{ doc.transaction_date}}</td>\n                </tr>\n            </table>\n        </div>\n        <div>\n            <table style=\"width: 100%; border-collapse: collapse;\">\n                <tr>\n                    <td style=\"color: #64748b; padding: 4px 0; width: 40%;\"><strong>Request Type:</strong></td>\n                    <td style=\"color: #0f172a; padding: 4px 0;\"><span style=\"background: #e0f2fe; color: #0369a1; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 600;\">{{ doc.material_request_type }}</span></td>\n                </tr>\n                <tr>\n                    <td style=\"color: #64748b; padding: 4px 0;\"><strong>Status:</strong></td>\n                    <td style=\"color: #0f172a; padding: 4px 0;\"><strong>{{ doc.status }}</strong></td>\n                </tr>\n            </table>\n        </div>\n    </div>\n\n    <!-- 3. Requested Items Table -->\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 25px;\">\n        <thead>\n            <tr style=\"background-color: #0056b3; color: white; text-align: left;\">\n                <th style=\"padding: 10px; border-top-left-radius: 4px; border-bottom-left-radius: 4px; width: 5%;\">#</th>\n                <th style=\"padding: 10px; width: 20%;\">Item Code</th>\n                <th style=\"padding: 10px; width: 45%;\">Description</th>\n                <th style=\"padding: 10px; width: 15%;\">Source Warehouse</th>\n                <th style=\"padding: 10px; text-align: right; border-top-right-radius: 4px; border-bottom-right-radius: 4px; width: 15%;\">Qty</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for item in doc.items %}\n            <tr style=\"border-bottom: 1px solid #e2e8f0;\">\n                <td style=\"padding: 10px; color: #64748b;\">{{ item.idx }}</td>\n                <td style=\"padding: 10px; font-weight: bold; color: #0f172a;\">{{ item.item_code }}</td>\n                <td style=\"padding: 10px;\">\n                    <div style=\"font-weight: 500; color: #1e293b;\">{{ item.item_name }}</div>\n                    {% if item.description and item.description != item.item_name %}\n                    <div style=\"font-size: 11px; color: #64748b; margin-top: 2px;\">{{ item.description }}</div>\n                    {% endif %}\n                </td>\n                <td style=\"padding: 10px; color: #475569; font-size: 12px;\">{{ item.warehouse or \"Not Set\" }}</td>\n                <td style=\"padding: 10px; text-align: right; font-weight: bold; color: #0f172a;\">{{ item.qty }} <span style=\"font-weight: normal; color: #64748b; font-size: 11px;\">{{ item.uom }}</span></td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n\n    <!-- 4. Summary & Verification Area (QR Code Component) -->\n    <div style=\"display: flex; justify-content: space-between; align-items: flex-end; margin-top: 40px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 6px; padding: 15px;\">\n        \n        <!-- Verification QR Code Container -->\n        <div style=\"display: flex; align-items: center; gap: 15px; max-width: 60%;\">\n            {% set base_url = frappe.utils.get_url() %}\n            {% set tracking_url = doc.name %}\n            {% set qr_api_url = \"https://api.qrserver.com/v1/create-qr-code/?size=110x110&data=\" ~ tracking_url | urlencode %}\n            \n            <div style=\"border: 1px solid #cbd5e1; padding: 4px; background: #fff; border-radius: 4px; display: inline-block;\">\n                <img src=\"{{ qr_api_url }}\" width=\"260\" height=\"110\" alt=\"Tracking QR Code\" style=\"display: block;\">\n            </div>\n            <div>\n                <div style=\"font-weight: bold; color: #0f172a; margin-bottom: 4px; font-size: 12px;\">System Tracking QR Link</div>\n                <p style=\"margin: 0; font-size: 11px; color: #64748b; line-height: 1.4;\">\n                    Scan this digital signature payload via smartphone camera optics to securely audit lifecycle approval sequences or track warehouse inventory routing updates instantly.\n                </p>\n            </div>\n        </div>\n\n        <!-- Dynamic Signatures Placeholders -->\n        <div style=\"width: 35%; text-align: center;\">\n            <div style=\"margin-bottom: 50px; border-bottom: 1px solid #94a3b8; width: 100%;\"></div>\n            <div style=\"font-size: 12px; font-weight: bold; color: #1e293b;\">Authorized Management Approval</div>\n            <div style=\"font-size: 10px; color: #94a3b8; margin-top: 2px;\">SIMS Control Authorization Signature</div>\n        </div>\n    </div>\n\n</div>",
