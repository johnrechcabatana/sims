 "doc_type": "Material Request",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <style>\n        /* =========================================================\n           PAGE SETUP & GENERAL STYLES\n           ========================================================= */\n        @page {\n            size: A4 portrait;\n            margin: 10mm;\n        }\n\n        html, body {\n            width: 100%;\n            margin: 0;\n            padding: 0;\n        }\n\n        body {\n            font-family: Arial, Helvetica, sans-serif;\n            color: #000000;\n            background-color: #ffffff;\n            line-height: 1.2;\n            font-size: 10px;\n            -webkit-print-color-adjust: exact !important;\n            print-color-adjust: exact !important;\n        }\n\n        /* =========================================================\n           MAIN CONTAINER FRAME\n           ========================================================= */\n        .outer-frame {\n            width: 100%;\n            box-sizing: border-box;\n            border: 1.5px solid #000000;\n            padding: 8px;\n            margin: 0 auto;\n            position: relative;\n        }\n\n        /* =========================================================\n           TABLE STYLES\n           ========================================================= */\n        table {\n            width: 100%;\n            border-collapse: collapse;\n            table-layout: fixed;\n        }\n\n        .border-table, .border-table th, .border-table td {\n            border: 1px solid #000000;\n        }\n\n        .border-table th {\n            font-weight: bold;\n            text-align: center;\n            padding: 5px 2px;\n            font-size: 9.5px;\n            background-color: #ffffff;\n        }\n\n        .border-table td {\n            padding: 3px 4px;\n            font-size: 9px;\n            box-sizing: border-box;\n        }\n\n        .align-center { text-align: center; }\n        .align-right { text-align: right; }\n        .align-left { text-align: left; }\n\n        /* =========================================================\n           SPECIAL SECTIONS & HEADERS\n           ========================================================= */\n        .header-title {\n            text-align: center;\n            font-size: 16px;\n            font-weight: bold;\n            letter-spacing: 0.5px;\n            margin-top: 5px;\n            margin-bottom: 20px;\n        }\n\n        .appendix-text {\n            position: absolute;\n            top: 8px;\n            right: 8px;\n            font-size: 9px;\n            font-weight: bold;\n            border: 1px solid #000;\n            padding: 2px 6px;\n        }\n\n        .line-field {\n            border-bottom: 1px solid #000000;\n            display: inline-block;\n            width: 70%;\n            min-height: 12px;\n            vertical-align: bottom;\n            padding-left: 5px;\n        }\n\n        .checkbox-box {\n            display: inline-block;\n            width: 10px;\n            height: 10px;\n            border: 1px solid #000;\n            margin-right: 6px;\n            vertical-align: middle;\n        }\n\n        /* Transfer Type Layout */\n        .transfer-type-grid {\n            display: flex;\n            justify-content: space-between;\n            margin-top: 4px;\n            padding-left: 10px;\n            padding-right: 10px;\n        }\n\n        .transfer-column {\n            display: flex;\n            flex-direction: column;\n            gap: 4px;\n        }\n\n        /* Print Override */\n        @media print {\n            .outer-frame {\n                border: 1.5px solid #000000 !important;\n            }\n        }\n    </style>\n</head>\n<body>\n\n    <div class=\"outer-frame\">\n\n        <!-- APPENDIX / FILE COPY BADGE -->\n        <div class=\"appendix-text\">\n            GHQ SAO FILE COPY\n        </div>\n\n        <!-- DOCUMENT TITLE -->\n        <div class=\"header-title\">\n            PROPERTY TRANSFER REPORT\n        </div>\n\n        <!-- ENTITY NAME & FUND CLUSTER (ABOVE MAIN BOX) -->\n        <table style=\"margin-bottom: 6px; border: none;\">\n            <tr>\n                <td width=\"55%\" style=\"padding: 2px 0;\">\n                    <strong>Entity Name:</strong> \n                    <span class=\"line-field\" style=\"width: 75%;\">{{ doc.company or doc.custom_client or \"\" }}</span>\n                </td>\n                <td width=\"45%\" style=\"padding: 2px 0;\">\n                    <strong>Fund Cluster:</strong> \n                    <span class=\"line-field\" style=\"width: 70%;\">{{ doc.custom_fund_cluster or \"\" }}</span>\n                </td>\n            </tr>\n        </table>\n\n        <!-- HEADER DATA SECTION -->\n        <table class=\"border-table\" style=\"margin-bottom: -1px;\">\n            <tr>\n                <td width=\"55%\" style=\"padding: 4px 6px; vertical-align: top;\">\n                    <div style=\"margin-bottom: 4px;\">\n                        <strong>From:</strong> \n                        <span class=\"line-field\" style=\"width: 82%;\">{{ doc.from_warehouse or \"\" }}</span>\n                    </div>\n                    <div>\n                        <strong>To:</strong> \n                        <span class=\"line-field\" style=\"width: 86%;\">{{ doc.to_warehouse or \"\" }}</span>\n                    </div>\n                </td>\n                <td width=\"45%\" style=\"padding: 4px 6px; vertical-align: top;\">\n                    <div style=\"margin-bottom: 4px;\">\n                        <strong>PTR No.:</strong> \n                        <span class=\"line-field\" style=\"width: 75%; font-weight: bold;\">{{ doc.name }}</span>\n                    </div>\n                    <div>\n                        <strong>Date:</strong> \n                        <span class=\"line-field\" style=\"width: 80%;\">{{ doc.posting_date or doc.transaction_date or \"\" }}</span>\n                    </div>\n                </td>\n            </tr>\n            <tr>\n                <td colspan=\"2\" style=\"padding: 6px;\">\n                    <strong>Transfer Type:</strong> (check only one)\n                    <div class=\"transfer-type-grid\" style=\"margin-top: 6px;\">\n                        <!-- Column 1 -->\n                        <div class=\"transfer-column\">\n                            <div><span class=\"checkbox-box\"></span> Donation</div>\n                            <div><span class=\"checkbox-box\"></span> Reassignment</div>\n                        </div>\n                        <!-- Column 2 -->\n                        <div class=\"transfer-column\" style=\"justify-content: flex-start;\">\n                            <div><span class=\"checkbox-box\"></span> Relocate</div>\n                        </div>\n                        <!-- Column 3 -->\n                        <div class=\"transfer-column\" style=\"justify-content: flex-start;\">\n                            <div>\n                                <span class=\"checkbox-box\"></span> Others (Specify) \n                                <span style=\"border-bottom: 1px solid #000; width: 140px; display: inline-block;\"></span>\n                            </div>\n                        </div>\n                    </div>\n                </td>\n            </tr>\n        </table>\n\n        <!-- ITEM TABLE -->\n        <table class=\"border-table\">\n            <thead>\n                <tr>\n                    <th width=\"12%\">Date Acquired</th>\n                    <th width=\"15%\">Property No.</th>\n                    <th width=\"37%\">Description</th>\n                    <th width=\"12%\">Unit Cost</th>\n                    <th width=\"12%\">Total Cost</th>\n                    <th width=\"12%\">Condition of PPE</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% set total_amount = [] %}\n                {% for item in doc.items %}\n                    {% set item_d = frappe.db.sql(\"Select valuation_rate from `tabItem` where name =%s\",item.item_code, as_dict =1)%}\n                    {% set valuation_rate = item_d[0].valuation_rate or 0 %}\n                    {% if valuation_rate > 50000%}\n                    {% set amount = item.amount or (item.qty * valuation_rate) or 0 %}\n                    {% set _ = total_amount.append(amount) %}\n                    <tr style=\"height: 20px;\">\n                        <td class=\"align-center\">{{ item.custom_date_acquired or \"\" }}</td>\n                        <td class=\"align-center\">{{ item.item_code }}</td>\n                        <td>\n                            {{ item.item_name }}\n                            {% if item.description and item.description != item.item_name %}\n                                <br><small style=\"color: #444;\">{{ item.description }}</small>\n                            {% endif %}\n                        </td>\n                        <td class=\"align-right\">{{ \"{:,.2f}\".format(valuation_rate | float) if valuation_rate else \"\" }}</td>\n                        <td class=\"align-right\">{{ \"{:,.2f}\".format(amount | float) if amount else \"\" }}</td>\n                        <td class=\"align-center\">{{ item.custom_condition or \"\" }}</td>\n                    </tr>\n                    {%endif%}\n                {% endfor %}\n\n                <!-- FILLER ROWS TO MATCH IMAGE HEIGHT (13 total rows target) -->\n                {% set total_items = doc.items | length %}\n                {% set max_rows = 13 %}\n                {% if total_items < max_rows %}\n                    {% for i in range(total_items + 1, max_rows + 1) %}\n                    <tr style=\"height: 20px;\">\n                        <td></td><td></td><td></td><td></td><td></td><td></td>\n                    </tr>\n                    {% endfor %}\n                {% endif %}\n\n                <!-- TOTAL ROW -->\n                <tr>\n                    <td colspan=\"4\" class=\"align-right\" style=\"font-weight: bold; padding-right: 8px;\">TOTAL</td>\n                    <td class=\"align-right\" style=\"font-weight: bold;\">\n                        {{ \"{:,.2f}\".format(total_amount | sum) }}\n                    </td>\n                    <td></td>\n                </tr>\n            </tbody>\n        </table>\n\n        <!-- NOTHING FOLLOWS MARKER (OUTSIDE/BELOW TABLE FRAME) -->\n        <div style=\"text-align: center; font-weight: bold; font-size: 9px; letter-spacing: 1px; margin: 4px 0;\">\n            ***** NOTHING FOLLOWS *****\n        </div>\n\n        <!-- AUTHORITY SECTION -->\n        <table class=\"border-table\" style=\"margin-top: 2px; margin-bottom: -1px;\">\n            <tr>\n                <td style=\"height: 38px; vertical-align: top; padding: 4px;\">\n                    <strong>Authority:</strong>\n                    <div style=\"margin-top: 2px; padding-left: 10px;\">\n                        {{ doc.reason_for_transfer or doc.remarks or \"\" }}\n                    </div>\n                </td>\n            </tr>\n        </table>\n\n        <!-- SIGNATURE BLOCK -->\n        <table class=\"border-table\">\n            <thead>\n                <tr>\n                    <th width=\"33%\" class=\"align-left\" style=\"padding-left: 6px;\">Approved by:</th>\n                    <th width=\"33%\" class=\"align-left\" style=\"padding-left: 6px;\">Released/Issued by:</th>\n                    <th width=\"34%\" class=\"align-left\" style=\"padding-left: 6px;\">Received by:</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <!-- APPROVED BY -->\n                    <td valign=\"top\" style=\"padding: 8px 6px;\">\n                        <div style=\"margin-bottom: 5px;\">\n                            Signature: <span class=\"line-field\" style=\"width: 68%;\"></span>\n                        </div>\n                        <div style=\"margin-bottom: 5px;\">\n                            Printed Name: <span class=\"line-field\" style=\"width: 58%; font-weight: bold;\">{{ doc.approved_by_name or \"\" }}</span>\n                        </div>\n                        <div style=\"margin-bottom: 5px;\">\n                            Designation: <span class=\"line-field\" style=\"width: 61%;\">{{ doc.approved_by_designation or \"\" }}</span>\n                        </div>\n                        <div>\n                            Date: <span class=\"line-field\" style=\"width: 78%;\">{{ doc.approval_date or \"\" }}</span>\n                        </div>\n                    </td>\n\n                    <!-- RELEASED / ISSUED BY -->\n                    <td valign=\"top\" style=\"padding: 8px 6px;\">\n                        <div style=\"margin-bottom: 5px;\">\n                            Signature: <span class=\"line-field\" style=\"width: 68%;\"></span>\n                        </div>\n                        <div style=\"margin-bottom: 5px;\">\n                            Printed Name: <span class=\"line-field\" style=\"width: 58%; font-weight: bold;\">{{ doc.issued_by_name or \"\" }}</span>\n                        </div>\n                        <div style=\"margin-bottom: 5px;\">\n                            Designation: <span class=\"line-field\" style=\"width: 61%;\">{{ doc.issued_by_designation or \"\" }}</span>\n                        </div>\n                        <div>\n                            Date: <span class=\"line-field\" style=\"width: 78%;\">{{ doc.issue_date or \"\" }}</span>\n                        </div>\n                    </td>\n\n                    <!-- RECEIVED BY -->\n                    <td valign=\"top\" style=\"padding: 8px 6px;\">\n                        <div style=\"margin-bottom: 5px;\">\n                            Signature: <span class=\"line-field\" style=\"width: 68%;\"></span>\n                        </div>\n                        <div style=\"margin-bottom: 5px;\">\n                            Printed Name: <span class=\"line-field\" style=\"width: 58%; font-weight: bold;\">{{ doc.received_by_name or doc.custom_client or \"\" }}</span>\n                        </div>\n                        <div style=\"margin-bottom: 5px;\">\n                            Designation: <span class=\"line-field\" style=\"width: 61%;\">{{ doc.received_by_designation or \"\" }}</span>\n                        </div>\n                        <div>\n                            Date: <span class=\"line-field\" style=\"width: 78%;\">{{ doc.receipt_date or \"\" }}</span>\n                        </div>\n                    </td>\n                </tr>\n            </tbody>\n        </table>\n\n    </div>\n\n</body>\n</html>",
 "idx": 0,
 "line_breaks": 0,
